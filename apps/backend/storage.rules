rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Browser clients must use backend-authorized signed URLs for all files.
    // Cloud Functions and signed URL requests bypass Firebase Storage Rules.
    match /businesses/{businessId}/invoices/{allPaths=**} {
      allow read, write: if false;
    }

    match /businesses/{businessId}/uploads/{allPaths=**} {
      allow read, write: if false;
    }

    match /exports/{userId}/{allPaths=**} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
